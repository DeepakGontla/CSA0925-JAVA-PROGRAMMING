package oops;
import java.util.ArrayList;
import java.util.Iterator;
import java.util.ListIterator;
class Employee {
    String name;
    String designation;
    double salaray;

    Employee(String name, String designation, double salaray) {
        this.name = name;
        this.designation = designation;
        this.salaray = salaray;
    }
}

public class Main {
    public static void main(String[] args) {

        ArrayList<Employee> AL = new ArrayList<>();

        Employee e1 = new Employee("deepak", "md", 5214);
        Employee e2 = new Employee("jhon", "hr", 4123);
        Employee e3 = new Employee("chris", "accountant", 3214);

        AL.add(e1);
        AL.add(e2);
        AL.add(e3);

        System.out.println("Employee Details");
        for (Employee e : AL) {
            System.out.println(e.name);
            System.out.println(e.designation);
            System.out.println(e.salaray);
            System.out.println();
        }

        String searchName = "jhon";
        boolean found = false;

        for (Employee e : AL) {
            if (e.name.contains(searchName)) {
                found = true;
                System.out.println("Employee Found");
                System.out.println(e.name);
                System.out.println(e.designation);
                System.out.println(e.salaray);
                break;
            }
        }

        if (!found) {
            System.out.println("Employee Not Found");
        }

        Employee highest = AL.get(0);

        for (Employee e : AL) {
            if (e.salaray > highest.salaray) {
                highest = e;
            }
        }

        System.out.println("\nHighest Paid Employee");
        System.out.println(highest.name);
        System.out.println(highest.designation);
        System.out.println(highest.salaray);
    }
}
